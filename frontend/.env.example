# Linera Configuration
# These values are populated automatically by conway_deploy.sh during deployment
# Copy to .env and fill in values for local development

# Linera Faucet URL - defaults to Conway testnet if not specified
VITE_LINERA_FAUCET_URL=https://faucet.testnet-conway.linera.net

# Application ID - obtained from linera publish-and-create
VITE_APP_ID=

# Chain ID - obtained from linera wallet show
VITE_CHAIN_ID=
